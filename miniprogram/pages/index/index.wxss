.app-shell {
  min-height: 100vh;
  background: #f6f7f3;
}

.page-content {
  padding: 34rpx 32rpx calc(148rpx + env(safe-area-inset-bottom));
}

.screen {
  animation: screen-in 240ms ease both;
}

@keyframes screen-in {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.hero-row,
.screen-title-row,
.section-heading-row,
.summary-heading,
.records-toolbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-row {
  position: relative;
  align-items: flex-start;
  gap: 18rpx;
}

.hero-copy {
  min-width: 0;
  flex: 1;
}

.date-label {
  display: block;
  margin-bottom: 11rpx;
  color: #d95643;
  font-size: 20rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  color: #1e2a38;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: 0;
  white-space: nowrap;
}

.hero-title.accent {
  color: #f06b56;
}

.hero-note,
.screen-note,
.section-note,
.empty-note,
.row-note,
.insight-note {
  display: block;
  color: #7e8991;
  line-height: 1.65;
}

.hero-note {
  margin-top: 16rpx;
  font-size: 22rpx;
}

.pregnancy-summary {
  width: 190rpx;
  flex-shrink: 0;
  padding-top: 11rpx;
  border-top: 1rpx solid #dce5de;
  color: #7e8991;
  font-size: 20rpx;
}

.pregnancy-summary view {
  display: flex;
  align-items: baseline;
  margin: 4rpx 0;
}

.pregnancy-number {
  margin-right: 4rpx;
  color: #1e2a38;
  font-size: 48rpx;
  font-weight: 800;
}

.pregnancy-number.small {
  margin-left: 10rpx;
  font-size: 34rpx;
}

.due-date {
  font-size: 18rpx;
}

.setup-button {
  flex: 0 0 150rpx;
  width: 150rpx;
  min-width: 0;
  height: 64rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  color: #d95643;
  background: #fde9e4;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 64rpx;
  white-space: nowrap;
}

.clock-section {
  padding: 54rpx 0 52rpx;
  text-align: center;
}

.clock-toolbar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.section-label {
  position: relative;
  flex: 0 0 76rpx;
  min-width: 76rpx;
  padding-left: 24rpx;
  color: #59676f;
  font-size: 22rpx;
  font-weight: 700;
  text-align: left;
  white-space: nowrap;
}

.section-label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid #7e8991;
  border-radius: 50%;
  transform: translateY(-50%);
}

.segmented-control,
.choice-control {
  display: flex;
  padding: 5rpx;
  border-radius: 14rpx;
  background: #e8eee9;
}

.clock-toolbar .segmented-control {
  flex: 1;
  min-width: 0;
}

.segment,
.choice {
  flex: 1;
  min-width: 0;
  width: auto;
  height: 50rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  color: #7e8991;
  background: transparent;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 50rpx;
}

.segment.selected,
.choice.selected {
  color: #1e2a38;
  background: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(39, 62, 52, 0.08);
}

.digital-clock {
  display: flex;
  align-items: baseline;
  justify-content: center;
  min-height: 164rpx;
}

.main-time {
  color: #1e2a38;
  font-family: Menlo, Monaco, monospace;
  font-size: 118rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0;
}

.seconds {
  margin-left: 10rpx;
  color: #f06b56;
  font-family: Menlo, Monaco, monospace;
  font-size: 24rpx;
}

.analog-clock {
  width: 420rpx;
  height: 420rpx;
  position: relative;
  margin: 0 auto;
  border: 2rpx solid #dce7df;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 30rpx 50rpx rgba(38, 72, 56, 0.09), inset 0 0 0 18rpx #edf3ee;
}

.clock-number {
  position: absolute;
  z-index: 1;
  color: #59676f;
  font-family: Menlo, Monaco, monospace;
  font-size: 22rpx;
}

.number-12 { top: 32rpx; left: 50%; transform: translateX(-50%); }
.number-3 { right: 37rpx; top: 50%; transform: translateY(-50%); }
.number-6 { bottom: 30rpx; left: 50%; transform: translateX(-50%); }
.number-9 { left: 37rpx; top: 50%; transform: translateY(-50%); }

.clock-hand {
  position: absolute;
  z-index: 2;
  left: 50%;
  bottom: 50%;
  transform-origin: 50% 100%;
  border-radius: 999rpx;
}

.hour-hand { width: 8rpx; height: 108rpx; background: #1e2a38; }
.minute-hand { width: 5rpx; height: 142rpx; background: #f06b56; }
.second-hand { width: 2rpx; height: 158rpx; background: #6e9680; }

.clock-pin {
  position: absolute;
  z-index: 3;
  left: calc(50% - 10rpx);
  top: calc(50% - 10rpx);
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid #f06b56;
  border-radius: 50%;
  background: #ffffff;
}

.record-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  margin-top: 38rpx;
}

.record-button {
  flex: 1;
  width: auto;
  max-width: 300rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  padding: 0 22rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: #f06b56;
  box-shadow: 0 20rpx 35rpx rgba(240, 107, 86, 0.22);
  font-size: 28rpx;
  font-weight: 800;
}

.record-button-pressed {
  transform: translateY(3rpx);
  box-shadow: 0 10rpx 22rpx rgba(240, 107, 86, 0.2);
}

.record-plus {
  margin-right: 18rpx;
  font-size: 42rpx;
  font-weight: 400;
}

.record-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.record-hint {
  margin-top: 5rpx;
  opacity: 0.78;
  font-size: 19rpx;
  font-weight: 500;
}

.today-count {
  flex: 0 0 78rpx;
  min-width: 78rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  color: #7e8991;
  font-size: 20rpx;
}

.count-number {
  margin-bottom: 3rpx;
  color: #1e2a38;
  font-family: Menlo, Monaco, monospace;
  font-size: 54rpx;
  font-weight: 600;
}

.home-summary,
.recent-section,
.export-section,
.chart-section,
.settings-section {
  padding: 34rpx 0 42rpx;
  border-top: 1rpx solid #dce5de;
}

.minor-label {
  display: block;
  color: #7e8991;
  font-family: Menlo, Monaco, monospace;
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.summary-title,
.section-title {
  display: block;
  margin-top: 8rpx;
  color: #1e2a38;
  font-size: 30rpx;
  font-weight: 800;
}

.link-button,
.danger-link,
.delete-button {
  width: auto;
  padding: 0;
  background: transparent;
}

.link-button {
  color: #d95643;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.wave-chart {
  height: 150rpx;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin: 38rpx 5rpx 12rpx;
}

.wave-track {
  height: 100%;
  flex: 1;
  display: flex;
  align-items: flex-end;
}

.wave-bar {
  width: 100%;
  min-height: 7rpx;
  border-radius: 7rpx 7rpx 0 0;
  background: #9bb7a8;
}

.wave-bar.coral {
  background: #f06b56;
}

.wave-axis {
  display: flex;
  justify-content: space-between;
  color: #7e8991;
  font-family: Menlo, Monaco, monospace;
  font-size: 17rpx;
}

.recent-section {
  margin-top: 2rpx;
}

.recent-list {
  margin-top: 28rpx;
}

.recent-row {
  min-height: 62rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #e7ece8;
}

.recent-row:active {
  opacity: 0.72;
}

.record-dot,
.timeline-dot,
.legend-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #f06b56;
}

.recent-time,
.timeline-datetime {
  flex: 0 0 176rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 3rpx;
}

.timeline-date {
  color: #7e8991;
  font-size: 17rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.timeline-time {
  color: #1e2a38;
  font-family: Menlo, Monaco, monospace;
  font-size: 23rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.timeline-time {
  flex: none;
}

.recent-day,
.timeline-kind {
  margin-left: auto;
  color: #7e8991;
  font-size: 19rpx;
}

.recent-edit {
  color: #547a99;
  font-size: 19rpx;
}

.inline-empty {
  min-height: 125rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: #7e8991;
  font-size: 22rpx;
}

.pulse-line {
  width: 40rpx;
  height: 18rpx;
  border-left: 4rpx solid #6e9680;
  border-bottom: 4rpx solid #6e9680;
  transform: skewY(-32deg);
}

.screen-title-row {
  align-items: flex-end;
  margin-bottom: 54rpx;
}

.screen-title {
  display: block;
  color: #1e2a38;
  font-size: 70rpx;
  font-weight: 800;
  line-height: 1.1;
}

.screen-note {
  margin-top: 13rpx;
  font-size: 23rpx;
}

.total-stat {
  min-width: 110rpx;
  padding-left: 26rpx;
  border-left: 1rpx solid #dce5de;
  color: #7e8991;
  font-size: 19rpx;
}

.total-number {
  display: block;
  margin-bottom: 8rpx;
  color: #1e2a38;
  font-family: Menlo, Monaco, monospace;
  font-size: 56rpx;
  font-weight: 600;
}

.coral-stat .total-number {
  color: #f06b56;
}

.export-section {
  padding-bottom: 38rpx;
}

.section-note {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.export-count {
  color: #d95643;
  font-size: 20rpx;
  font-weight: 700;
}

.date-range {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.date-picker {
  flex: 1;
  min-width: 0;
}

.date-picker view {
  min-height: 80rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 20rpx;
  border: 1rpx solid #dce5de;
  border-radius: 12rpx;
  background: #ffffff;
  color: #1e2a38;
  font-size: 22rpx;
}

.date-caption {
  margin-bottom: 4rpx;
  color: #7e8991;
  font-size: 18rpx;
}

.dark-button,
.outline-button {
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 80rpx;
}

.dark-button {
  margin-top: 18rpx;
  color: #ffffff;
  background: #1e2a38;
}

.records-toolbar {
  align-items: center;
  padding: 34rpx 0 26rpx;
}

.records-toolbar .section-title {
  margin-top: 0;
}

.records-toolbar-copy {
  min-width: 0;
}

.records-toolbar-copy .section-note {
  margin-top: 5rpx;
}

.record-filter-control {
  display: flex;
  gap: 6rpx;
  margin: 0 0 32rpx;
  padding: 5rpx;
  border-radius: 14rpx;
  background: #e8eee9;
}

.record-filter {
  flex: 1;
  min-width: 0;
  height: 52rpx;
  margin: 0;
  padding: 0 10rpx;
  border-radius: 10rpx;
  color: #7e8991;
  background: transparent;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 52rpx;
  white-space: nowrap;
}

.record-filter.selected {
  color: #1e2a38;
  background: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(39, 62, 52, 0.08);
}

.record-layout-control {
  min-height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin: -18rpx 0 24rpx;
  color: #7e8991;
  font-size: 18rpx;
}

.layout-option {
  width: 72rpx;
  height: 44rpx;
  margin: 0;
  padding: 0;
  border-radius: 9rpx;
  color: #7e8991;
  background: transparent;
  font-size: 18rpx;
  line-height: 44rpx;
}

.layout-option.selected {
  color: #1e2a38;
  background: #e8eee9;
  font-weight: 700;
}

.danger-link {
  color: #d95643;
  font-size: 21rpx;
  line-height: 44rpx;
}

.danger-link[disabled],
.danger-row[disabled] {
  opacity: 0.4;
}

.day-group {
  margin-bottom: 42rpx;
}

.day-heading {
  position: sticky;
  top: 0;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 0;
  background: #f6f7f3;
}

.day-heading:active {
  opacity: 0.68;
}

.day-heading-copy,
.day-heading-meta {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.day-heading-copy {
  flex-wrap: wrap;
  gap: 10rpx;
}

.day-relative {
  color: #d95643;
  font-size: 27rpx;
  font-weight: 800;
}

.day-date {
  color: #1e2a38;
  font-size: 24rpx;
  font-weight: 800;
}

.day-heading-meta {
  flex: 0 0 auto;
  gap: 14rpx;
}

.day-count {
  color: #7e8991;
  font-size: 19rpx;
  font-weight: 500;
}

.day-toggle {
  color: #547a99;
  font-size: 19rpx;
}

.day-records {
  margin-left: 6rpx;
  border-left: 1rpx solid #dce5de;
}

.timeline-row {
  min-height: 82rpx;
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-left: 32rpx;
  border-bottom: 1rpx solid #e7ece8;
}

.timeline.compact .day-records {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 18rpx;
  border-left: 0;
}

.timeline.compact .timeline-row {
  min-height: 86rpx;
  gap: 9rpx;
  padding-left: 20rpx;
}

.timeline.compact .timeline-datetime {
  flex: 1;
  min-width: 0;
}

.timeline.compact .timeline-kind {
  display: none;
}

.timeline.compact .timeline-actions {
  flex: 0 0 84rpx;
  min-width: 84rpx;
  gap: 2rpx;
}

.timeline.compact .edit-button,
.timeline.compact .delete-button {
  flex-basis: 40rpx;
  width: 40rpx;
  min-width: 40rpx;
  font-size: 17rpx;
}

.timeline.compact .timeline-date {
  font-size: 16rpx;
}

.timeline.compact .timeline-time {
  font-size: 21rpx;
}

.timeline-row .timeline-dot {
  position: absolute;
  left: -7rpx;
  box-shadow: 0 0 0 7rpx #f6f7f3;
}

.timeline-kind {
  flex: 0 0 42rpx;
  min-width: 0;
  margin-left: 0;
  white-space: nowrap;
}

.timeline-actions {
  flex: 0 0 104rpx;
  min-width: 104rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-left: auto;
}

.edit-button,
.delete-button {
  flex: 0 0 48rpx;
  width: 48rpx;
  min-width: 48rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  font-size: 19rpx;
  line-height: 50rpx;
  white-space: nowrap;
}

.edit-button {
  color: #547a99;
}

.delete-button {
  color: #a7b1ab;
}

.edit-panel {
  margin: 0 0 34rpx;
  padding: 26rpx 24rpx 24rpx;
  border: 1rpx solid #dce5de;
  border-radius: 16rpx;
  background: #ffffff;
}

.edit-panel-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.edit-panel-heading .section-title {
  margin-top: 0;
}

.edit-cancel {
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  color: #7e8991;
  background: transparent;
  font-size: 20rpx;
  line-height: 46rpx;
}

.edit-fields {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.edit-picker {
  flex: 1;
  min-width: 0;
}

.edit-picker view {
  min-height: 76rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 18rpx;
  border: 1rpx solid #dce5de;
  border-radius: 12rpx;
  color: #1e2a38;
  font-size: 21rpx;
}

.edit-save-button {
  margin-top: 18rpx;
}

.empty-state {
  min-height: 620rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.filter-empty {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-symbol {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 26rpx;
  border-radius: 50%;
  background: #e8efe9;
}

.empty-title {
  font-size: 31rpx;
  font-weight: 800;
}

.empty-note {
  margin: 13rpx 0 28rpx;
  font-size: 21rpx;
}

.outline-button {
  width: 210rpx;
  color: #d95643;
  background: #fde9e4;
}

.chart-section {
  padding-bottom: 36rpx;
}

.bar-chart {
  height: 350rpx;
  display: flex;
  align-items: flex-end;
  gap: 18rpx;
  padding-top: 42rpx;
}

.bar-column {
  height: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-items: center;
  align-items: center;
  gap: 8rpx;
}

.bar-value {
  color: #d95643;
  font-family: Menlo, Monaco, monospace;
  font-size: 18rpx;
}

.bar-track,
.hour-track {
  width: 58rpx;
  height: 100%;
  display: flex;
  align-items: flex-end;
  border-radius: 12rpx 12rpx 0 0;
  background: #e9eeea;
}

.bar-track {
  flex: 1;
  min-height: 0;
}

.bar-fill,
.hour-fill {
  width: 100%;
  min-height: 6rpx;
  border-radius: 12rpx 12rpx 0 0;
  background: #f06b56;
}

.bar-fill.empty,
.hour-fill.empty {
  background: #dfe7e1;
}

.bar-label {
  color: #7e8991;
  font-size: 18rpx;
}

.hourly-section {
  margin-top: 4rpx;
}

.hour-chart {
  height: 250rpx;
  display: flex;
  align-items: flex-end;
  gap: 22rpx;
  padding: 44rpx 8rpx 0;
}

.hour-column {
  height: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9rpx;
}

.hour-track {
  flex: 1;
  min-height: 0;
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  background: #edf1ee;
}

.hour-fill {
  border-radius: 8rpx 8rpx 0 0;
  background: #9bb7a8;
}

.chart-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 26rpx;
  color: #7e8991;
  font-size: 18rpx;
}

.legend {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-dot {
  background: #9bb7a8;
}

.insight-strip {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 16rpx;
  background: #fde9e4;
}

.spark-mark {
  color: #f06b56;
  font-size: 34rpx;
}

.insight-title {
  display: block;
  font-size: 23rpx;
  font-weight: 800;
}

.insight-note {
  margin-top: 5rpx;
  font-size: 19rpx;
}

.settings-section {
  padding-bottom: 44rpx;
}

.compact-section {
  margin-top: 0;
}

.settings-heading {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.settings-mark {
  width: 16rpx;
  height: 16rpx;
  margin-top: 13rpx;
  border-radius: 50%;
}

.coral-mark { background: #f06b56; }
.blue-mark { background: #547a99; }
.danger-mark { background: #d95643; }

.choice-control {
  width: calc(100% - 34rpx);
  box-sizing: border-box;
  display: inline-flex;
  margin: 34rpx 0 28rpx 34rpx;
}

.choice {
  padding: 0 28rpx;
}

.setting-field,
.setting-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-left: 34rpx;
  border-bottom: 1rpx solid #dce5de;
  color: #1e2a38;
  font-size: 23rpx;
}

.field-value {
  color: #1e2a38;
  font-family: Menlo, Monaco, monospace;
  font-size: 21rpx;
}

.field-value.placeholder {
  color: #9ca7a0;
  font-family: inherit;
}

.due-summary {
  display: flex;
  gap: 78rpx;
  margin: 28rpx 0 0 34rpx;
  padding-top: 26rpx;
  border-top: 1rpx dashed #dce5de;
  color: #7e8991;
  font-size: 19rpx;
}

.due-summary view {
  display: flex;
  flex-direction: column;
}

.due-value {
  margin-top: 8rpx;
  color: #1e2a38;
  font-family: Menlo, Monaco, monospace;
  font-size: 29rpx;
  font-weight: 600;
}

.setting-row {
  width: calc(100% - 34rpx);
  box-sizing: border-box;
  padding: 0;
  background: transparent;
  text-align: left;
  line-height: 1.2;
  justify-content: flex-start;
  position: relative;
}

.setting-row view {
  width: 100%;
  flex: none;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.setting-row view text {
  text-align: left;
}

.login-card {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-left: 34rpx;
  border-bottom: 1rpx solid #dce5de;
}

.login-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.login-title {
  color: #1e2a38;
  font-size: 23rpx;
  font-weight: 700;
}

.login-card .row-note {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.phone-login-button,
.logout-button,
.login-help-button {
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-radius: 10rpx;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 54rpx;
  white-space: nowrap;
}

.local-mode-note {
  display: block;
  margin: 18rpx 0 0 34rpx;
  color: #7e8991;
  font-size: 18rpx;
  line-height: 1.65;
}

.phone-login-button,
.logout-button {
  flex: 0 0 168rpx;
  width: 168rpx;
  height: 54rpx;
  color: #ffffff;
  background: #547a99;
}

.phone-login-button[disabled] {
  opacity: 0.58;
}

.logout-button {
  color: #547a99;
  background: #e6eef2;
}

.login-help-button {
  display: block;
  margin: 16rpx 0 0 34rpx;
  color: #7e8991;
  background: transparent;
  font-weight: 500;
  line-height: 44rpx;
  text-align: left;
}

.row-note {
  margin-top: 8rpx;
  font-size: 18rpx;
}

.row-arrow {
  position: absolute;
  right: 0;
  top: 50%;
  color: #a7b1ab;
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
  transform: translateY(-50%);
}

.danger-row {
  color: #d95643;
}

.privacy-note {
  padding: 28rpx;
  border-radius: 16rpx;
  color: #59676f;
  background: #e8efe9;
  font-size: 20rpx;
  line-height: 1.75;
}

.bottom-nav {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  height: 116rpx;
  display: flex;
  align-items: stretch;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 8rpx 12rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid #dce5de;
  background: rgba(255, 255, 255, 0.97);
}

.nav-item {
  flex: 1;
  min-width: 0;
  width: auto;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  color: #59676f;
  background: transparent;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
}

.nav-item.active {
  color: #d95643;
  background: #fde9e4;
}

.nav-symbol {
  width: 34rpx;
  height: 30rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.home-symbol {
  width: 22rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-radius: 3rpx;
}

.home-symbol::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 2rpx;
  width: 17rpx;
  height: 17rpx;
  border-left: 3rpx solid currentColor;
  border-top: 3rpx solid currentColor;
  transform: rotate(45deg);
}

.timeline-symbol {
  width: 25rpx;
  height: 25rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}

.timeline-symbol::before,
.timeline-symbol::after {
  content: '';
  position: absolute;
  left: 8rpx;
  width: 18rpx;
  border-top: 3rpx solid currentColor;
}

.timeline-symbol::before { top: 12rpx; }
.timeline-symbol::after { top: 20rpx; }

.bars-symbol {
  gap: 4rpx;
}

.bars-symbol view {
  width: 5rpx;
  border-radius: 3rpx 3rpx 0 0;
  background: currentColor;
}

.bars-symbol view:nth-child(1) { height: 12rpx; }
.bars-symbol view:nth-child(2) { height: 24rpx; }
.bars-symbol view:nth-child(3) { height: 18rpx; }

.gear-symbol {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.gear-symbol::after {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 11rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: currentColor;
}

@media (max-width: 350px) {
  .hero-title { font-size: 52rpx; }
  .main-time { font-size: 104rpx; }
  .record-button { max-width: 270rpx; }
  .pregnancy-summary { width: 170rpx; }
  .timeline.compact .day-records { grid-template-columns: 1fr; }
}
